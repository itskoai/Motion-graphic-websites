# Only lead.php and confirm.php are meant to be opened in this folder.
# (No "Options -Indexes" here: hosts that do not allow Options in .htaccess answer 500 for the whole folder.
#  The empty index.html keeps the folder from being listed instead.)
<FilesMatch "^(config\.php|config\.sample\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
